+        active = false;
+        for (int g = 0; g < MOE_N_GRP; ++g) {
+            n_expert[g] = 0;
+            lut[g].assign(n_expert_total, 0);
+        }
+        for (int32_t e = 0; e < n_expert_total && e < LLAMA_MAX_EXPERTS; ++e) {
+            grp_of[e]   = -1;
+            local_of[e] = 0;
+        }
