diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 8620c6c7a..b328e2f8c 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1737,6 +1737,274 @@ static void ggml_compute_forward_mul_mat_id(
 
 /////////////////////////////////
 
+// ggml_compute_forward_mul_mat_id_grp
+
+#define MMID_GRP_MAX 3
+
+// Work-buffer layout for the fused graded-MoE matmul:
+//   - one quantized copy of src1 per distinct vec_dot_type across the groups
+//     (the K-quant groups all share Q8_K, so typically a single copy),
+//   - per group: row counts, a mask-filtered routing table with the same
+//     layout the stock mul_mat_id kernels expect, atomic chunk counters, and
+//     a per-thread tiled workspace.
+// Every (slot, token) pair is owned by exactly one group, so each group's
+// kernels write disjoint slots of dst directly: no temporaries, no accumulation
+// pass, and across groups exactly n_used expert rows are evaluated per token.
+
+struct ggml_mmid_grp_wd {
+    // per group
+    enum ggml_type ved[MMID_GRP_MAX];
+    int            qowner[MMID_GRP_MAX];
+    bool           need_qsrc[MMID_GRP_MAX]; // group's vec_dot_type differs from src1's
+    size_t         qsrc_off[MMID_GRP_MAX];  // offset before assign(), pointer after
+    size_t         counts_off[MMID_GRP_MAX];  // [n_as_g] int64
+    size_t         rows_off[MMID_GRP_MAX];    // [n_as_g][n_ids*n_tok] mmid_row_mapping
+    size_t         atomics_off[MMID_GRP_MAX]; // [n_as_g] cache-lined counters
+    size_t         tiled_off[MMID_GRP_MAX];   // per-thread tiled workspace
+    size_t         total;
+};
+
+static void ggml_mul_mat_id_grp_layout(const struct ggml_tensor * dst, int nth, struct ggml_mmid_grp_wd * wd) {
+    const struct ggml_tensor * src1 = dst->src[3];
+
+    memset(wd, 0, sizeof(*wd));
+
+    // deduplicate the groups' vec_dot_types
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        wd->ved[g] = type_traits_cpu[dst->src[g]->type].vec_dot_type;
+
+        wd->qowner[g] = g;
+        for (int q = 0; q < g; ++q) {
+            if (wd->ved[q] == wd->ved[g]) {
+                wd->qowner[g] = wd->qowner[q];
+                break;
+            }
+        }
+    }
+
+    size_t off = 0;
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        wd->need_qsrc[g] = wd->qowner[g] == g && src1->type != wd->ved[g];
+        if (wd->qowner[g] != g) {
+            wd->qsrc_off[g] = wd->qsrc_off[wd->qowner[g]];
+            continue;
+        }
+        if (!wd->need_qsrc[g]) {
+            continue;
+        }
+        wd->qsrc_off[g] = off;
+        off += GGML_PAD(ggml_row_size(wd->ved[g], ggml_nelements(src1)), 64);
+    }
+
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        const struct ggml_tensor * w = dst->src[g];
+        const struct ggml_tensor * ids = dst->src[4 + g];
+        const int n_as = (int) w->ne[2];
+
+        wd->counts_off[g] = off;
+        off += GGML_PAD(n_as*sizeof(int64_t) + sizeof(int64_t), 64);
+
+        wd->rows_off[g] = off;
+        off += GGML_PAD(n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping) + sizeof(int64_t), 64);
+
+        wd->atomics_off[g] = off;
+        off += GGML_PAD(CACHE_LINE_SIZE*n_as + CACHE_LINE_SIZE, 64);
+
+        struct ggml_tensor fake = *dst;
+        fake.src[0] = dst->src[g];
+        fake.src[1] = src1;
+        wd->tiled_off[g] = off;
+        off += GGML_PAD(ggml_tiled_wdata_size(nth, &fake), 64);
+    }
+
+    wd->total = off;
+}
+
+static void ggml_mul_mat_id_grp_assign(const struct ggml_mmid_grp_wd * lay, char * base, struct ggml_mmid_grp_wd * wd) {
+    *wd = *lay;
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        // groups sharing a vec_dot_type inherit the owner's already-assigned
+        // pointer (qowner[g] < g, so the owner is always assigned first)
+        if (lay->qowner[g] != g) {
+            wd->qsrc_off[g] = wd->qsrc_off[lay->qowner[g]];
+        } else {
+            const uintptr_t q = ((uintptr_t) base + lay->qsrc_off[g] + 63) & ~(uintptr_t) 63;
+            wd->qsrc_off[g] = wd->need_qsrc[g] ? (size_t) q : 0;
+        }
+        wd->counts_off[g]  = ((uintptr_t) base + lay->counts_off[g] + 63) & ~(uintptr_t) 63;
+        wd->rows_off[g]    = ((uintptr_t) base + lay->rows_off[g] + 63) & ~(uintptr_t) 63;
+        wd->atomics_off[g] = ((uintptr_t) base + lay->atomics_off[g] + 63) & ~(uintptr_t) 63;
+        wd->tiled_off[g]   = ((uintptr_t) base + lay->tiled_off[g] + 63) & ~(uintptr_t) 63;
+    }
+}
+
+static void ggml_compute_forward_mul_mat_id_grp(
+        const struct ggml_compute_params * params,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * src0 = dst->src[0]; // group 0, only for the LOCALS macro
+    const struct ggml_tensor * src1 = dst->src[3];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    struct ggml_tensor * w[MMID_GRP_MAX]   = { dst->src[0], dst->src[1], dst->src[2] };
+    struct ggml_tensor * ids[MMID_GRP_MAX] = { dst->src[4], dst->src[5], dst->src[6] };
+    struct ggml_tensor * msk[MMID_GRP_MAX] = { dst->src[7], dst->src[8], dst->src[9] };
+
+    GGML_ASSERT(nth == params->threadpool->n_threads); // pool-wide barrier below
+
+    struct ggml_mmid_grp_wd lay;
+    ggml_mul_mat_id_grp_layout(dst, nth, &lay);
+    GGML_ASSERT(params->wsize >= lay.total);
+
+    struct ggml_mmid_grp_wd wd;
+    ggml_mul_mat_id_grp_assign(&lay, (char *) params->wdata, &wd);
+
+    // 1) quantize src1 once per distinct vec_dot_type, split across threads
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        if (!wd.need_qsrc[g] || wd.qowner[g] != g) {
+            continue;
+        }
+        ggml_from_float_t const from_float = type_traits_cpu[wd.ved[g]].from_float;
+        if (!from_float) {
+            GGML_ABORT("unsupported vec_dot_type in mul_mat_id_grp");
+        }
+
+        const size_t nbw0 = ggml_type_size(wd.ved[g]);
+        const size_t nbw1 = ggml_row_size(wd.ved[g], ne10);
+        const size_t nbw2 = nbw1*ne11;
+        const size_t nbw3 = nbw2*ne12;
+        char * qdata = (char *) wd.qsrc_off[g];
+
+        for (int64_t i13 = 0; i13 < ne13; ++i13) {
+            for (int64_t i12 = 0; i12 < ne12; ++i12) {
+                for (int64_t i11 = 0; i11 < ne11; ++i11) {
+                    size_t bs = ggml_blck_size(wd.ved[g]);
+                    int64_t ne10_block_start = (ith * ne10/bs) / nth;
+                    int64_t ne10_block_end   = ((ith + 1) * ne10/bs) / nth;
+                    from_float((float *)((char *) src1->data + i13*nb13 + i12*nb12 + i11*nb11 + ne10_block_start*bs*nb10),
+                               (void *)               (qdata + i13*nbw3 + i12*nbw2 + i11*nbw1 + ne10_block_start*nbw0),
+                               (ne10_block_end - ne10_block_start) * bs);
+                }
+            }
+        }
+    }
+
+    // 2) thread 0 routes the owned (slot, token) pairs per group
+    if (ith == 0) {
+        for (int g = 0; g < MMID_GRP_MAX; ++g) {
+            const int n_ids = (int) ids[g]->ne[0];
+            const int n_as  = (int) w[g]->ne[2];
+            const size_t row_cap = (size_t) n_ids * ids[g]->ne[1];
+
+            int64_t * counts = (int64_t *) wd.counts_off[g];
+            memset(counts, 0, n_as*sizeof(int64_t));
+
+            struct mmid_row_mapping * rows = (struct mmid_row_mapping *) wd.rows_off[g];
+
+            for (int64_t iid1 = 0; iid1 < ids[g]->ne[1]; ++iid1) {
+                for (int id = 0; id < n_ids; ++id) {
+                    const float m = *(const float *) ((const char *) msk[g]->data + id*msk[g]->nb[0] + iid1*msk[g]->nb[1]);
+                    if (m == 0.0f) {
+                        continue;
+                    }
+                    const int32_t i02 = *(const int32_t *) ((const char *) ids[g]->data + iid1*ids[g]->nb[1] + id*ids[g]->nb[0]);
+                    GGML_ASSERT(i02 >= 0 && i02 < n_as);
+                    rows[(size_t) i02*row_cap + counts[i02]] = (struct mmid_row_mapping) { (int32_t) id, (int32_t) iid1 };
+                    counts[i02] += 1;
+                }
+            }
+        }
+    }
+
+    // 3) reset the atomic chunk counters of every group
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        const int n_as = (int) w[g]->ne[2];
+        for (int cur_a = ith; cur_a < n_as; cur_a += nth) {
+            atomic_int * ctr = (atomic_int *) (wd.atomics_off[g] + (size_t) cur_a*CACHE_LINE_SIZE);
+            *ctr = nth;
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // 4) per-group compute over the filtered tables; the kernels write only the
+    // owned slots of dst, and every slot is owned by exactly one group
+    const bool src1_cont = ggml_is_contiguous(src1);
+
+    for (int g = 0; g < MMID_GRP_MAX; ++g) {
+        const int n_as = (int) w[g]->ne[2];
+        const int64_t * counts = (const int64_t *) wd.counts_off[g];
+        const struct mmid_row_mapping * rows = (const struct mmid_row_mapping *) wd.rows_off[g];
+        const size_t row_cap = (size_t) ids[g]->ne[0] * ids[g]->ne[1];
+        const size_t row_size = ggml_row_size(wd.ved[g], ne10);
+        const void * qsrc = (src1->type == wd.ved[g]) ? src1->data : (const void *) wd.qsrc_off[g];
+
+        // per-group view for the tiled helper (it reads dst->src[0]/[1]);
+        // data and strides stay dst's so writes land in the shared output
+        struct ggml_tensor fake = *dst;
+        fake.src[0] = w[g];
+        fake.src[1] = src1;
+
+        struct ggml_compute_params p = *params;
+        p.wdata = (char *) qsrc;
+
+        for (int64_t cur_a = 0; cur_a < n_as; ++cur_a) {
+            const int64_t cne1 = counts[cur_a];
+            if (cne1 == 0) {
+                continue;
+            }
+
+            if (ggml_compute_forward_mul_mat_id_tiled(&p, &fake, cur_a, cne1,
+                    (const int32_t *) (rows + cur_a*row_cap), (char *) wd.tiled_off[g])) {
+                continue;
+            }
+
+            // stock chunked path, mirrors ggml_compute_forward_mul_mat_id
+            const char * src0_cur = (const char *) w[g]->data + cur_a*w[g]->nb[2];
+            const int64_t nr0 = w[g]->ne[1];
+            const int64_t nr1 = cne1;
+
+            int chunk_size = (nr0 == 1 || nr1 == 1) ? 64 : 16;
+            const bool disable_chunking = ggml_is_numa();
+
+            int64_t nchunk0 = (nr0 + chunk_size - 1) / chunk_size;
+            int64_t nchunk1 = (nr1 + chunk_size - 1) / chunk_size;
+
+            if (nchunk0*nchunk1 < nth*4 || disable_chunking) {
+                nchunk0 = nr0 > nr1 ? nth : 1;
+                nchunk1 = nr0 > nr1 ? 1 : nth;
+            }
+
+            const int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+            const int64_t dr1 = (nr1 + nchunk1 - 1) / nchunk1;
+
+            int current_chunk = ith;
+            atomic_int * ctr = (atomic_int *) (wd.atomics_off[g] + (size_t) cur_a*CACHE_LINE_SIZE);
+
+            while (current_chunk < nchunk0*nchunk1) {
+                const int64_t ith0 = current_chunk % nchunk0;
+                const int64_t ith1 = current_chunk / nchunk0;
+
+                /* one_chunk re-indexes the table by cur_a itself (MMID_MATRIX_ROW):
+                   pass the full table, not the expert's offset */
+                ggml_compute_forward_mul_mat_id_one_chunk(&fake, w[g], src1, ids[g], cur_a,
+                        dr0*ith0, MIN(dr0*ith0 + dr0, nr0), dr1*ith1, MIN(dr1*ith1 + dr1, nr1),
+                        src0_cur, rows, row_size, src1_cont, qsrc);
+
+                if (nth >= nchunk0*nchunk1) {
+                    break;
+                }
+                current_chunk = atomic_fetch_add_explicit(ctr, 1, memory_order_relaxed);
+            }
+        }
+    }
+}
