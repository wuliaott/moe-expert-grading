+// ggml_mul_mat_id_grp
+
+/*
+    c = ggml_mul_mat_id_grp(ctx, w_grp, n_grp, b, ids_grp, msk_grp);
+
+    w_grp[g]   -> [cols, rows, n_expert_g]   (quantization type may differ per group)
+    b          -> [cols, n_used (broadcastable), n_tokens]
+    ids_grp[g] -> [n_used, n_tokens] (i32, row index inside group g)
+    msk_grp[g] -> [n_used, n_tokens] (f32, 0/1 slot ownership)
+    c          -> [rows, n_used, n_tokens]
+
+    c[:,:,t] = sum_g msk_grp[g][:,:,t] .* (w_grp[g][:,:,ids_grp[g][:,:,t]] @ b[:,:,t])
+
+    every (slot, token) is owned by exactly one group, so across groups exactly
+    n_used expert rows are evaluated per token, as in a single fused mul_mat_id.
+*/
+struct ggml_tensor * ggml_mul_mat_id_grp(
+        struct ggml_context * ctx,
+        struct ggml_tensor ** w_grp,
+        int                   n_grp,
+        struct ggml_tensor  * b,
+        struct ggml_tensor ** ids_grp,
+        struct ggml_tensor ** msk_grp) {
+    GGML_ASSERT(n_grp >= 1 && n_grp <= 3); // limited by GGML_MAX_SRC
+    GGML_ASSERT(!ggml_is_transposed(w_grp[0]));
+    GGML_ASSERT(b->ne[3] == 1); // b is 3d
+
+    for (int g = 0; g < n_grp; ++g) {
+        struct ggml_tensor * w = w_grp[g];
+        struct ggml_tensor * ids = ids_grp[g];
+        struct ggml_tensor * msk = msk_grp[g];
+
+        GGML_ASSERT(!ggml_is_transposed(w));
+        GGML_ASSERT(w->ne[3] == 1); // w is 3d (one matrix per expert)
+        GGML_ASSERT(ids->type == GGML_TYPE_I32);
+        GGML_ASSERT(msk->type == GGML_TYPE_F32);
+        GGML_ASSERT(ids->ne[2] == 1 && ids->ne[3] == 1); // ids is 2d
+        GGML_ASSERT(msk->ne[2] == 1 && msk->ne[3] == 1); // msk is 2d
+        GGML_ASSERT(ids->ne[0] == msk->ne[0] && ids->ne[1] == msk->ne[1]);
+        GGML_ASSERT(w->ne[0] == b->ne[0]); // can_mul_mat
+        GGML_ASSERT(w->ne[1] == w_grp[0]->ne[1]); // same rows in every group
+    }
+
+    GGML_ASSERT(ids_grp[0]->ne[0] % b->ne[1] == 0); // can broadcast
+
+    const int64_t ne[4] = { w_grp[0]->ne[1], ids_grp[0]->ne[0], b->ne[2], 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    result->op = GGML_OP_MUL_MAT_ID_GRP;
+    for (int g = 0; g < n_grp; ++g) {
+        result->src[g]     = w_grp[g];
+        result->src[4 + g] = ids_grp[g];
+        result->src[7 + g] = msk_grp[g];
+    }
+    result->src[3] = b;
+
+    return result;
+}
